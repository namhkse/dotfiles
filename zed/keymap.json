[
  {
    "context": "Workspace",
    "bindings": {
      "shift shift": "file_finder::Toggle",
      "\\ r": "workspace::FormatAndSave",
    },
  },
  {
    "context": "Editor && vim_mode == normal",
    "bindings": {
      "H": "vim::GoToPreviousTab",
      "L": "vim::GoToTab",
      "s": "vim::PushSneak",
      "shift-s": "vim::PushSneakBackward",
    },
  },
  {
    "context": "Editor && vim_mode == insert",
    "bindings": {
      "j j": "vim::NormalBefore",
    },
  },
]
